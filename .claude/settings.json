{
  "language": "japanese",
  "permissions": {
    "allow": ["Bash(*)"],
    "ask": [
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git push*)",
      "Bash(git clone*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(*install*)",
      "Bash(go get*)",
      "Bash(*sudo*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *go/*.go|*go/go.mod|*go/go.sum) cd /workspaces/san-db-ox-clients && make go-build ;; esac; }"
          }
        ]
      }
    ]
  }
}
