# scripts/fetch-san-db-ox.sh が本体バイナリをここへ置く
# (.claude/rules/testing.md)。ソースは追跡しないが、go/ 配下のソース
# コードはこの対象ではない。
/bin/

# Go のテスト・カバレッジ成果物
*.test
*.out

# Python の venv・ビルド・キャッシュ成果物
/python/.venv/
/python/dist/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# TypeScript の依存・ビルド成果物（package-lock.json は追跡する）
/typescript/node_modules/
/typescript/dist/
/typescript/build-test/

# 保険: テストが cwd を隔離し損ねた場合に snapshot/overwrite が
# ここへ書き込みうる（実際に一度、隔離漏れで snapshot 出力がここに
# コミットされる事故があった。原因はテスト側で修正済みだが、
# 再発時に誤ってコミットしないための最終防衛線として残す）。
/typescript/san-db-ox
/typescript/san-db-ox.exe

*.log
.DS_Store
